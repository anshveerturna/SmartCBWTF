<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/splashFragment">

    <fragment
        android:id="@+id/splashFragment"
        android:name="com.smartcbwtf.mobile.ui.SplashFragment"
        android:label=""
        tools:layout="@layout/fragment_splash">
        <action
            android:id="@+id/action_splashFragment_to_loginFragment"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/splashFragment"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_splashFragment_to_homeFragment"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/splashFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.smartcbwtf.mobile.ui.LoginFragment"
        android:label=""
        tools:layout="@layout/fragment_login">
        <action
            android:id="@+id/action_loginFragment_to_homeFragment"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_loginFragment_to_permissionsFragment"
            app:destination="@id/permissionsFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/permissionsFragment"
        android:name="com.smartcbwtf.mobile.ui.PermissionsFragment"
        android:label="Permissions"
        tools:layout="@layout/fragment_permissions">
        <action
            android:id="@+id/action_permissionsFragment_to_homeFragment"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/permissionsFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.smartcbwtf.mobile.ui.HomeFragment"
        android:label=""
        tools:layout="@layout/fragment_home">
        <action
            android:id="@+id/action_homeFragment_to_startPickupFragment"
            app:destination="@id/startPickupFragment" />
        <action
            android:id="@+id/action_homeFragment_to_verifyAtCbtwfFragment"
            app:destination="@id/scanWeighFragment">
            <argument
                android:name="hcfId"
                app:argType="string"
                android:defaultValue="" />
            <argument
                android:name="eventType"
                app:argType="string"
                android:defaultValue="CBWTF_VERIFICATION" />
        </action>
        <action
            android:id="@+id/action_homeFragment_to_scanWeighFragment"
            app:destination="@id/scanWeighFragment">
            <argument
                android:name="hcfId"
                app:argType="string"
                android:defaultValue="" />
            <argument
                android:name="eventType"
                app:argType="string"
                android:defaultValue="HCF_COLLECTION" />
        </action>
        <action
            android:id="@+id/action_homeFragment_to_hcfRegistrationFragment"
            app:destination="@id/hcfRegistrationFragment" />
        <action
            android:id="@+id/action_homeFragment_to_loginFragment"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/homeFragment"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_homeFragment_to_settingsFragment"
            app:destination="@id/settingsFragment" />
        <action
            android:id="@+id/action_homeFragment_to_profileFragment"
            app:destination="@id/profileFragment" />
        <action
            android:id="@+id/action_homeFragment_to_attendanceFragment"
            app:destination="@id/attendanceFragment" />
    </fragment>

    <fragment
        android:id="@+id/attendanceFragment"
        android:name="com.smartcbwtf.mobile.ui.AttendanceFragment"
        android:label="Mark Attendance"
        tools:layout="@layout/fragment_attendance">
        <argument
            android:name="latitude"
            app:argType="float"
            android:defaultValue="0.0" />
        <argument
            android:name="longitude"
            app:argType="float"
            android:defaultValue="0.0" />
    </fragment>

    <fragment
        android:id="@+id/profileFragment"
        android:name="com.smartcbwtf.mobile.ui.ProfileFragment"
        android:label="Profile"
        tools:layout="@layout/fragment_profile" />

    <fragment
        android:id="@+id/startPickupFragment"
        android:name="com.smartcbwtf.mobile.ui.StartPickupFragment"
        android:label="Start Pickup"
        tools:layout="@layout/fragment_start_pickup">
        <action
            android:id="@+id/action_startPickupFragment_to_scanWeighFragment"
            app:destination="@id/scanWeighFragment" />
    </fragment>

    <fragment
        android:id="@+id/scanWeighFragment"
        android:name="com.smartcbwtf.mobile.ui.ScanWeighFragment"
        android:label="Scan &amp; Weigh"
        tools:layout="@layout/fragment_scan_weigh">
        <argument
            android:name="hcfId"
            app:argType="string"
            android:defaultValue="" />
        <argument
            android:name="eventType"
            app:argType="string"
            android:defaultValue="HCF_COLLECTION" />
        <action
            android:id="@+id/action_scanWeighFragment_to_qrScannerFragment"
            app:destination="@id/qrScannerFragment" />
    </fragment>

    <fragment
        android:id="@+id/qrScannerFragment"
        android:name="com.smartcbwtf.mobile.ui.scanner.QrScannerFragment"
        android:label="Scan QR"
        tools:layout="@layout/fragment_qr_scanner" />

    <fragment
        android:id="@+id/hcfRegistrationFragment"
        android:name="com.smartcbwtf.mobile.ui.HcfRegistrationFragment"
        android:label="Register HCF"
        tools:layout="@layout/fragment_hcf_registration" />

    <fragment
        android:id="@+id/settingsFragment"
        android:name="com.smartcbwtf.mobile.ui.SettingsFragment"
        android:label="Settings"
        tools:layout="@layout/fragment_settings" />

    <!-- Security: Forced password change screen -->
    <fragment
        android:id="@+id/changePasswordFragment"
        android:name="com.smartcbwtf.mobile.ui.ChangePasswordFragment"
        android:label="Change Password"
        tools:layout="@layout/fragment_change_password">
        <action
            android:id="@+id/action_changePasswordFragment_to_homeFragment"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_changePasswordFragment_to_loginFragment"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true" />
    </fragment>

</navigation>
